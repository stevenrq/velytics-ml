# Local development environment template. Copy to .env.dev and fill in real values.
# For production, use .env.example instead.

APP_NAME=velytics-ml
APP_VERSION=0.1.0
ENVIRONMENT=dev

# Database (velytics-postgres container, host port 5433, db velytics_ml)
DATABASE_URL=postgresql+asyncpg://velytics:velytics@localhost:5433/velytics_ml
DATABASE_RUN_MIGRATIONS=true
DATABASE_ECHO=false

# velytics-backend integration
VELYTICS_API_URL=http://localhost:3000/api/v1
SERVICE_API_KEY=dev-only-service-key-change-me-32chars-min
JWKS_URL=http://localhost:3000/.well-known/jwks.json
JWT_ISSUER=http://localhost:3000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Model registry
MODEL_DIR=models
MODEL_NAME=demand_forecaster
DEFAULT_HORIZON_MONTHS=6
REQUEST_TIMEOUT_SECONDS=15.0
MIN_HISTORY_MONTHS=6
TARGET_COLUMN=sales_count

# Cold-start / residuals
COLD_START_MIN_MONTHS=3
RESIDUAL_SHRINKAGE_PRIOR=5

# Data quality
OUTLIER_IQR_MULTIPLIER=3.0

# Hyperparameter tuning
ENABLE_HYPERPARAMETER_TUNING=true
CV_FOLDS=3
CV_N_JOBS=-1
CV_N_ITER=10
MODEL_SELECTION_METRIC=weighted
MODEL_SELECTION_MAPE_WEIGHT=0.4

# Direct multi-step forecast
FORECAST_DAMPENING_RATE=0.05
FORECAST_DAMPENING_FLOOR=0.5
MAX_TRAINING_HORIZON=12
LAG_WINDOW_SHORT=3
LAG_WINDOW_LONG=6

# Feature importance
ENABLE_FEATURE_IMPORTANCE=true

# Permissions (claim `authorities` in the velytics-backend JWT)
PERMISSIONS_PREDICT=ml:predict
PERMISSIONS_RETRAIN=ml:retrain
PERMISSIONS_MODELS=ml:models
